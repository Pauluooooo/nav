# Home HTML injects the Cloudflare Pages commit SHA into every asset URL (`?v=<sha>`).
# A new deployment therefore uses new URLs, so fingerprinted CSS/JS can stay in browser/edge cache.
# This removes a full revalidation round-trip for every returning visitor.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# Other static assets can still cache aggressively.
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

# HTML Files - Do not cache (Revalidate)
# Ensures users always get the latest version references
/*.html
  Cache-Control: public, max-age=0, must-revalidate
